TEAM_ID=

PRODUCT_NAME=SubsTracker
PRODUCT_BUNDLE_IDENTIFIER=me.efedaniel.substracker.SubsTracker$(TEAM_ID)

CURRENT_PROJECT_VERSION=1
MARKETING_VERSION=1.0

// The shared framework is static, so SQLiter's (SQLDelight native driver)
// sqlite3 symbols must be linked by the app itself.
OTHER_LDFLAGS=$(inherited) -lsqlite3